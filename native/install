#!/bin/sh
# Installs the power helper for Firefox, for this user: Slop Detect then scores only while
# the computer is plugged in. Linux only; needs python3. `native/install --remove` undoes it.
set -eu

NAME=slop_detect_power
HELPER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/slop-detect"
MANIFEST="$HOME/.mozilla/native-messaging-hosts/$NAME.json"

if [ "${1:-}" = "--remove" ]; then
  rm -f "$MANIFEST" "$HELPER_DIR/$NAME.py"
  echo "removed $MANIFEST and $HELPER_DIR/$NAME.py"
  exit 0
fi

mkdir -p "$HELPER_DIR" "$(dirname "$MANIFEST")"
install -m 755 "$(dirname "$0")/$NAME.py" "$HELPER_DIR/$NAME.py"
cat > "$MANIFEST" <<JSON
{
  "name": "$NAME",
  "description": "Tells Slop Detect whether this computer runs on mains power",
  "path": "$HELPER_DIR/$NAME.py",
  "type": "stdio",
  "allowed_extensions": ["slop-detect@1-bart-1.github.io"]
}
JSON
echo "installed $HELPER_DIR/$NAME.py and $MANIFEST"
