    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "linkedom": "^0.18.15",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
